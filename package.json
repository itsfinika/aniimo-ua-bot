{
  "name": "aniimo-ua-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram submission/news bot for the Aniimo UA community, with optional Telegram and Discord chat moderation.",
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node main.js",
    "test": "vitest run",
