    "lint": "eslint .",
    "check": "node --check main.js && node -e \"import('./main.js')\""
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "bgutils-js": "^4.0.3",
    "cheerio": "^1.1.2",
    "discord.js": "^14.23.2",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.3.1",
    "grammy": "^1.39.1",
    "jsdom": "^30.0.1",
    "luxon": "^3.7.2",
    "youtubei.js": "^18.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "vitest": "^3.2.4"
  }
}
